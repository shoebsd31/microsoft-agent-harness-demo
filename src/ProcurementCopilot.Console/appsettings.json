{
  "Foundry": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "",
    "JudgeDeploymentName": "",
    "UseV1Path": true,
    "StoreResponses": false
  },
  "Agent": {
    "MaxContextWindowTokens": 128000,
    "MaxOutputTokens": 16384,
    "MaxFunctionInvocationIterations": 15,
    "MaxLoopIterations": 5,
    "EnableWebSearch": true,
    "EnableLocalWebFetch": false,
    "EnableJudge": false,
    "BackgroundAgents": {
      "MaxParallel": 2,
      "TimeoutSeconds": 120
    }
  },
  "Workspace": {
    "Root": "workspace",
    "ReadOnlyPaths": [ "rfps" ],
    "WritablePaths": [ "output" ],
    "MaxFileBytes": 1048576,
    "AllowedExtensions": [ ".md", ".txt", ".json", ".csv", ".jsonl" ]
  },
  "Security": {
    "ApprovalPolicy": {
      "RequireApprovalFor": [ "draft_clarification_email", "record_award_recommendation", "shell" ]
    },
    "Shell": {
      "AllowedCommands": [ "ls", "dir", "cat", "type", "head", "tail", "wc", "grep", "findstr", "find", "pwd", "echo" ],
      "TimeoutSeconds": 10,
      "MaxOutputBytes": 32768
    }
  },
  "Sessions": {
    "Directory": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "EnableSensitiveData": false,
    "ConsoleExporter": false
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
