@page "/bids"
@rendermode InteractiveServer
@using ProcurementCopilot.Application.Abstractions
@inject IProcurementAdminStore Store

<PageTitle>Bids</PageTitle>
<h1>Bids</h1>

@if (error is not null) { <div class="alert alert-danger">@error</div> }

<div class="d-flex gap-2 mb-3">
    <select class="form-select w-auto" @bind="filter" @bind:after="LoadAsync">
        <option value="">All RFPs</option>
        @foreach (var r in rfps) { <option value="@r.RfpId">@r.RfpId — @r.Title</option> }
    </select>
    <button class="btn btn-primary" @onclick="New">New bid</button>
</div>

<table class="table table-sm table-striped">
    <thead><tr><th>Bid</th><th>RFP</th><th>Vendor</th><th>Price</th><th>Lead (wk)</th><th>Warranty (mo)</th><th>Tech %</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in bids)
    {
        <tr>
            <td>@b.BidId</td><td>@b.RfpId</td><td>@b.VendorName (VND-@b.BusinessEntityId.ToString("0000"))</td>
            <td>@b.UnitPrice.ToString("N2") @b.CurrencyCode</td><td>@b.LeadTimeWeeks</td><td>@b.WarrantyMonths</td><td>@b.TechnicalCompliancePercent</td>
            <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(b)">Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(b)">Delete</button></td>
        </tr>
    }
    </tbody>
</table>

@if (editing is not null)
{
    <div class="card mt-3"><div class="card-body">
        <h5>@(editing.BidNumber == 0 ? "New bid" : "Edit " + editing.BidId)</h5>
        <EditForm Model="editing" OnValidSubmit="SaveAsync">
            <div class="row g-2">
                <div class="col-md-3"><label class="form-label">RFP</label>
                    <InputSelect class="form-select" @bind-Value="editing.RfpId">@foreach (var r in rfps) { <option value="@r.RfpId">@r.RfpId</option> }</InputSelect></div>
                <div class="col-md-5"><label class="form-label">Vendor</label>
                    <InputSelect class="form-select" @bind-Value="editing.BusinessEntityId">@foreach (var v in vendors) { <option value="@v.BusinessEntityId">@v.Name (@v.VendorId)</option> }</InputSelect></div>
                <div class="col-md-2"><label class="form-label">Unit price</label><InputNumber class="form-control" @bind-Value="editing.UnitPrice" /></div>
                <div class="col-md-2"><label class="form-label">Currency</label><InputText class="form-control" @bind-Value="editing.CurrencyCode" /></div>
                <div class="col-md-2"><label class="form-label">Lead time (weeks)</label><InputNumber class="form-control" @bind-Value="editing.LeadTimeWeeks" /></div>
                <div class="col-md-2"><label class="form-label">Warranty (months)</label><InputNumber class="form-control" @bind-Value="editing.WarrantyMonths" /></div>
                <div class="col-md-2"><label class="form-label">Technical %</label><InputNumber class="form-control" @bind-Value="editing.TechnicalCompliancePercent" /></div>
                <div class="col-12"><label class="form-label">Delivery clause (vendor-authored, shown to the agent as untrusted data)</label><InputTextArea class="form-control" rows="2" @bind-Value="editing.DeliveryClause" /></div>
                <div class="col-12"><label class="form-label">Notes (vendor-authored)</label><InputTextArea class="form-control" rows="2" @bind-Value="editing.Notes" /></div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="() => editing = null">Cancel</button>
            </div>
        </EditForm>
    </div></div>
}

@code {
    private List<AdminBid> bids = [];
    private IReadOnlyList<AdminRfp> rfps = [];
    private IReadOnlyList<AdminVendor> vendors = [];
    private AdminBid? editing;
    private string filter = string.Empty;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { rfps = await Store.ListRfpsAsync(); vendors = await Store.ListVendorsAsync(); await LoadAsync(); }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }

    private async Task LoadAsync()
    {
        try { bids = (await Store.ListBidsAsync(string.IsNullOrEmpty(filter) ? null : filter)).ToList(); error = null; }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }

    private void New() => editing = new AdminBid { RfpId = string.IsNullOrEmpty(filter) ? rfps.FirstOrDefault()?.RfpId ?? string.Empty : filter, BusinessEntityId = vendors.FirstOrDefault()?.BusinessEntityId ?? 0 };

    private void Edit(AdminBid b) => editing = new AdminBid { BidNumber = b.BidNumber, BidId = b.BidId, RfpId = b.RfpId, BusinessEntityId = b.BusinessEntityId, UnitPrice = b.UnitPrice, CurrencyCode = b.CurrencyCode, LeadTimeWeeks = b.LeadTimeWeeks, WarrantyMonths = b.WarrantyMonths, TechnicalCompliancePercent = b.TechnicalCompliancePercent, DeliveryClause = b.DeliveryClause, Notes = b.Notes };

    private async Task SaveAsync()
    {
        try { await Store.SaveBidAsync(editing!); editing = null; await LoadAsync(); }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }

    private async Task DeleteAsync(AdminBid b)
    {
        try { await Store.DeleteBidAsync(b.BidNumber); await LoadAsync(); }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }
}
