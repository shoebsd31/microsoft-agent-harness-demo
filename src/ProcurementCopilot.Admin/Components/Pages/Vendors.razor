@page "/vendors"
@rendermode InteractiveServer
@using ProcurementCopilot.Application.Abstractions
@inject IProcurementAdminStore Store

<PageTitle>Vendors</PageTitle>
<h1>Vendors</h1>
<p class="text-muted">All AdventureWorks vendors. Name, credit rating and active flag come from <code>Purchasing.Vendor</code> (read-only); the copilot profile (country override, years trading, notes, certifications) lives in the <code>Procurement</code> schema.</p>

@if (error is not null) { <div class="alert alert-danger">@error</div> }

<input class="form-control mb-2 w-50" placeholder="filter by name or id" @bind="search" @bind:event="oninput" />

<table class="table table-sm table-striped">
    <thead><tr><th>Id</th><th>Name</th><th>Credit</th><th>Active</th><th>Country</th><th>Years</th><th>Certifications</th><th>Restricted</th><th></th></tr></thead>
    <tbody>
    @foreach (var v in vendors.Where(Matches))
    {
        <tr class="@(v.IsRestricted ? "table-danger" : "")">
            <td>@v.VendorId</td><td>@v.Name</td><td>@v.CreditRating</td><td>@(v.Active ? "yes" : "no")</td>
            <td>@(v.CountryOverride ?? v.Country)</td><td>@v.YearsTrading</td><td>@v.Certifications</td><td>@(v.IsRestricted ? "yes" : "")</td>
            <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(v)">Edit profile</button></td>
        </tr>
    }
    </tbody>
</table>

@if (editing is not null)
{
    <div class="card mt-3"><div class="card-body">
        <h5>@editing.Name (@editing.VendorId)</h5>
        <EditForm Model="editing" OnValidSubmit="SaveAsync">
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label">Country override (blank = @editing.Country)</label><InputText class="form-control" @bind-Value="editing.CountryOverride" /></div>
                <div class="col-md-2"><label class="form-label">Years trading</label><InputNumber class="form-control" @bind-Value="editing.YearsTrading" /></div>
                <div class="col-md-6"><label class="form-label">Certifications (comma separated, e.g. ISO 9001, ISO 4210, ISO 14001)</label><InputText class="form-control" @bind-Value="editing.Certifications" /></div>
                <div class="col-12"><label class="form-label">Notes (vendor-authored; the agent treats this as untrusted data)</label><InputTextArea class="form-control" rows="3" @bind-Value="editing.Notes" /></div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="() => editing = null">Cancel</button>
            </div>
        </EditForm>
    </div></div>
}

@code {
    private IReadOnlyList<AdminVendor> vendors = [];
    private AdminVendor? editing;
    private string search = string.Empty;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool Matches(AdminVendor v) => string.IsNullOrWhiteSpace(search) || v.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || v.VendorId.Contains(search, StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync()
    {
        try { vendors = await Store.ListVendorsAsync(); error = null; }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }

    private void Edit(AdminVendor v) => editing = new AdminVendor { BusinessEntityId = v.BusinessEntityId, VendorId = v.VendorId, Name = v.Name, Country = v.Country, CountryOverride = v.CountryOverride, YearsTrading = v.YearsTrading, Notes = v.Notes, Certifications = v.Certifications };

    private async Task SaveAsync()
    {
        try { await Store.SaveVendorProfileAsync(editing!); editing = null; await LoadAsync(); }
        catch (Microsoft.Data.SqlClient.SqlException ex) { error = ex.Message; }
    }
}
